# ==============================================================================
# MOTION TENNIS — VARIÁVEIS DE AMBIENTE PÚBLICAS DO FRONTEND (Vite / Vercel)
# ==============================================================================
# IMPORTANTE:
# Utilize exclusivamente a chave anônima pública (anon / publishable key).
# NUNCA insira a service_role_key ou segredos administrativos no frontend.
# ==============================================================================

# Modo de execução: 'web_demo' para Vercel / 'equipment' para notebook da quadra
VITE_APP_MODE=web_demo

# URL do projeto Supabase (Ex: https://seu-projeto.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública do Supabase (anon / publishable key)
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# (Opcional) URL base da API do equipamento caso exposto externamente
VITE_API_URL=
